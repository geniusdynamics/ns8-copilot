#
# Save the CoPilot settings and write copilot.env, read by the backend.
#
# - Each setting is kept in the module environment as COPILOT_<NAME>, so
#   get-configuration, restore and clone find it again. A setting left out
#   of the request keeps its current value (or the CoPilot default).
# - The secrets are in mysql.env, minio.env and secrets.env (create-module),
#   the mail settings in smarthost.env (bin/discover-smarthost) and the
#   settings the admin sets by hand in custom.env, read last.
#

import json
import os
import sys

import agent

data = json.load(sys.stdin)

# input key: (CoPilot variable, type, default), see the upstream .env.example
SETTINGS = {
    "access_token_expire_minutes": ("ACCESS_TOKEN_EXPIRE_MINUTES", int, 1440),
    "audit_log_retention_days": ("AUDIT_LOG_RETENTION_DAYS", int, 90),
    "default_alert_severity": ("DEFAULT_ALERT_SEVERITY", str, "High"),
    "announcements_enabled": ("ANNOUNCEMENTS_ENABLED", bool, True),
    "talon_release_check_enabled": ("TALON_RELEASE_CHECK_ENABLED", bool, True),
    "mail_from": ("SMTP_FROM", str, ""),
}


def env_value(value, kind):
    if kind is bool:
        return "true" if value else "false"
    return str(value).strip()


host = data["host"]
agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", data.get("http2https", True))
agent.set_env("TRAEFIK_LETS_ENCRYPT", data.get("lets_encrypt", False))

copilot = {
    "SERVER_IP": "0.0.0.0",
    # The containers of the pod reach each other on 127.0.0.1
    "MYSQL_URL": "127.0.0.1",
    "MINIO_URL": "127.0.0.1",
    "MINIO_SECURE": "False",
    # Links in notifications and e-mails, passkey login
    "COPILOT_URL": "https://" + host,
    "WEBAUTHN_RP_ID": host,
    "WEBAUTHN_RP_NAME": "SOCFortress CoPilot",
    "WEBAUTHN_ORIGINS": "https://" + host,
}

for key, (name, kind, default) in SETTINGS.items():
    if key in data:
        value = env_value(data[key], kind)
    elif "COPILOT_" + name in os.environ:
        value = os.environ["COPILOT_" + name]
    else:
        value = env_value(default, kind)
    agent.set_env("COPILOT_" + name, value)
    if name == "SMTP_FROM":
        continue  # written by bin/discover-smarthost, with the mail settings
    copilot[name] = value

agent.write_envfile("copilot.env", copilot)
os.chmod("copilot.env", 0o600)
agent.dump_env()
