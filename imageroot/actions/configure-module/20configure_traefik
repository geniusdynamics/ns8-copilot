# Route the host name to the CoPilot frontend, published on 127.0.0.1

import json
import os
import sys

import agent
import agent.tasks

data = json.load(sys.stdin)

traefik_id = agent.resolve_agent_id('traefik@node')
agent.assert_exp(traefik_id is not None, "No Traefik instance on this node")

response = agent.tasks.run(
    agent_id=traefik_id,
    action='set-route',
    data={
        'instance': os.environ['MODULE_ID'],
        'url': 'http://127.0.0.1:' + os.environ["TCP_PORT"],
        'host': data["host"],
        'http2https': data.get("http2https", True),
        'lets_encrypt': data.get("lets_encrypt", False),
    },
)
agent.assert_exp(response['exit_code'] == 0, "Cannot set the Traefik route")
