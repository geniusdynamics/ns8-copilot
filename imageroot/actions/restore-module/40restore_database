#
# Load the copilot.sql dump of the backup into a new mysql-data volume: a
# temporary MySQL creates the root account and the copilot user (mysql.env),
# runs copilot.sql from its init directory, then the script below stops it.
#

set -e -o pipefail
exec 1>&2

if [[ ! -f copilot.sql ]]; then
    echo "No copilot.sql in the backup: CoPilot starts with an empty database"
    exit 0
fi

mkdir -vp initdb.d
mv -v copilot.sql initdb.d/
cat - >initdb.d/zz_copilot_restore.sh <<'EOS'
# Sourced by the entrypoint after copilot.sql: stop and exit
mysql --version
set -- true
docker_temp_server_stop
exit 0
EOS
trap 'rm -rfv initdb.d/' EXIT

podman run \
    --rm \
    --interactive \
    --network=none \
    --volume=./initdb.d:/docker-entrypoint-initdb.d:z \
    --volume=mysql-data:/var/lib/mysql:Z \
    --env-file=mysql.env \
    --replace --name=restore_db \
    "${MYSQL_IMAGE}"
