# Copy the route and the CoPilot settings (COPILOT_*) from the backed-up
# environment. The secrets come back with mysql.env, minio.env, secrets.env
# and custom.env.

import json
import sys

import agent

renv = json.load(sys.stdin)["environment"]
for name, value in renv.items():
    if name in ("TRAEFIK_HOST", "TRAEFIK_HTTP2HTTPS") or name.startswith("COPILOT_"):
        agent.set_env(name, value)
agent.dump_env()
