# Remove the Traefik route. An instance that was never configured has none:
# a failure here must not stop the removal of the module.

import os
import sys

import agent
import agent.tasks

traefik_id = agent.resolve_agent_id('traefik@node')
if traefik_id:
    response = agent.tasks.run(
        agent_id=traefik_id,
        action='delete-route',
        data={'instance': os.environ['MODULE_ID']},
    )
    if response['exit_code'] != 0:
        print(agent.SD_WARNING + "Cannot remove the Traefik route", file=sys.stderr)
