#
# The clone already has the state directory, the volumes and the COPILOT_*
# settings of the source. Pass every setting to configure-module anyway, so
# nothing falls back to a default. Let's Encrypt stays off: the DNS name may
# not point to this node.
#

import os

import agent
import agent.tasks

env = os.environ


def flag(name, default):
    return env.get(name, default).lower() == "true"


data = {
    "host": env["TRAEFIK_HOST"],
    "http2https": flag("TRAEFIK_HTTP2HTTPS", "True"),
    "lets_encrypt": False,
}
for key, name in (("access_token_expire_minutes", "ACCESS_TOKEN_EXPIRE_MINUTES"),
                  ("audit_log_retention_days", "AUDIT_LOG_RETENTION_DAYS")):
    if env.get("COPILOT_" + name, "").isdigit():
        data[key] = int(env["COPILOT_" + name])
for key, name in (("default_alert_severity", "DEFAULT_ALERT_SEVERITY"), ("mail_from", "SMTP_FROM")):
    if "COPILOT_" + name in env:
        data[key] = env["COPILOT_" + name]
for key, name in (("announcements_enabled", "ANNOUNCEMENTS_ENABLED"),
                  ("talon_release_check_enabled", "TALON_RELEASE_CHECK_ENABLED")):
    if "COPILOT_" + name in env:
        data[key] = flag("COPILOT_" + name, "true")

ret = agent.tasks.run(agent_id=env["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(ret["exit_code"] == 0, "The configure-module subtask failed!")
