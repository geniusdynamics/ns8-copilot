#
# Generate the secrets once, in files readable by the module only. They
# never go to the module environment: agent.set_env() stores it in Redis,
# readable by every module.
#
# - mysql.env: the MySQL root password and the copilot user, read by MySQL
#   and by the backend (it creates the database with the root account)
# - minio.env: the MinIO root account, read by MinIO and by the backend
# - secrets.env: the backend keys. TOTP_ENCRYPTION_KEY and
#   WAF_TOKEN_ENCRYPTION_KEY are Fernet keys (32 url-safe base64 bytes).
# - custom.env: empty, for the upstream settings the admin sets by hand
#

import base64
import os
import secrets

state = os.environ["AGENT_STATE_DIR"]


def fernet_key():
    return base64.urlsafe_b64encode(secrets.token_bytes(32)).decode()


def write_new(name, values, header=""):
    path = os.path.join(state, name)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return  # never replace existing secrets
    with os.fdopen(fd, "w") as fp:
        fp.write(header)
        for key, value in values.items():
            fp.write(f"{key}={value}\n")


write_new("mysql.env", {
    "MYSQL_ROOT_PASSWORD": secrets.token_urlsafe(24),
    "MYSQL_DATABASE": "copilot",
    "MYSQL_USER": "copilot",
    "MYSQL_PASSWORD": secrets.token_urlsafe(24),
})
write_new("minio.env", {
    "MINIO_ROOT_USER": "copilot",
    "MINIO_ROOT_PASSWORD": secrets.token_urlsafe(24),
})
write_new("secrets.env", {
    "JWT_SECRET": secrets.token_urlsafe(48),
    "SSO_STATE_SECRET": secrets.token_urlsafe(48),
    "TOTP_ENCRYPTION_KEY": fernet_key(),
    "WAF_TOKEN_ENCRYPTION_KEY": fernet_key(),
})
write_new("custom.env", {}, header=(
    "# CoPilot settings of the upstream .env.example, one NAME=value per line.\n"
    "# They override the module values. Apply with:\n"
    "#   systemctl --user restart copilot-backend.service\n"
))
