#
# Pod of SOCFortress CoPilot: MySQL, MinIO, the backend, the Nuclei module
# and the frontend share its network and reach each other on 127.0.0.1.
# The upstream images call each other by their docker-compose names: these
# names point to 127.0.0.1. Only the frontend (port 8080) is published, on
# the loopback interface, for Traefik.
#
[Unit]
Description=Podman copilot.service
Requires=mysql-app.service minio-app.service copilot-backend.service copilot-nuclei.service copilot-frontend.service
Before=mysql-app.service minio-app.service copilot-backend.service copilot-nuclei.service copilot-frontend.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%E/state/environment
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/copilot.pid %t/copilot.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/copilot.pid \
    --pod-id-file %t/copilot.pod-id \
    --name copilot \
    --publish 127.0.0.1:${TCP_PORT}:8080 \
    --add-host copilot-mysql:127.0.0.1 \
    --add-host copilot-minio:127.0.0.1 \
    --add-host copilot-backend:127.0.0.1 \
    --add-host copilot-nuclei-module:127.0.0.1 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/copilot.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/copilot.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/copilot.pod-id
PIDFile=%t/copilot.pid
Type=forking

[Install]
WantedBy=default.target
