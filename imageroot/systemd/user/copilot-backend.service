#
# CoPilot backend (FastAPI, port 5000). At start it creates the database,
# runs the migrations, creates the MinIO buckets and, the first time, the
# admin user: its password is printed once in the log. The environment
# files, read in this order:
# - copilot.env: settings written by configure-module
# - mysql.env, minio.env, secrets.env (0600): passwords and keys
# - smarthost.env (0600): SMTP_* settings from the NS8 smarthost
# - custom.env (0600): upstream settings the admin sets by hand
# The unit is started once the API answers.
#
[Unit]
Description=Podman copilot-backend.service
BindsTo=copilot.service
After=copilot.service mysql-app.service minio-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/copilot-backend.pid %t/copilot-backend.ctr-id
ExecStartPre=/usr/bin/touch %E/state/smarthost.env %E/state/custom.env
ExecStartPre=-runagent discover-smarthost
ExecStart=/usr/bin/podman run --conmon-pidfile %t/copilot-backend.pid \
    --cidfile %t/copilot-backend.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/copilot.pod-id --replace -d --name copilot-backend \
    --volume copilot-logs:/opt/logs:Z \
    --volume copilot-data:/opt/copilot/backend/data:Z \
    --env-file=%E/state/copilot.env \
    --env-file=%E/state/mysql.env \
    --env-file=%E/state/minio.env \
    --env-file=%E/state/secrets.env \
    --env-file=%E/state/smarthost.env \
    --env-file=%E/state/custom.env \
    ${COPILOT_BACKEND_IMAGE}
ExecStartPost=/bin/bash -c "until podman exec copilot-backend curl -sf -o /dev/null http://127.0.0.1:5000/; do \
    [[ $$(podman inspect -f '{{.State.Running}}' copilot-backend) == true ]] || exit 1; sleep 5; done"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/copilot-backend.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/copilot-backend.ctr-id
SyslogIdentifier=%u
PIDFile=%t/copilot-backend.pid
Type=forking

[Install]
WantedBy=default.target
