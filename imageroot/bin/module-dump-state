# Before a backup: dump the CoPilot database, restored by
# restore-module/40restore_database. The root password stays inside the
# container, in the environment of mysqldump.

set -e -o pipefail

if ! systemctl --user -q is-active mysql-app.service; then
    exit 0
fi
echo "Dumping the copilot database" 1>&2
podman exec mysql-app sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysqldump -uroot \
    --databases copilot \
    --default-character-set=utf8mb4 \
    --skip-dump-date \
    --single-transaction \
    --quick \
    --routines \
    --add-drop-table' > copilot.sql
