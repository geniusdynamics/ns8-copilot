#
# Write smarthost.env with the SMTP_* settings CoPilot reads, from the
# cluster smarthost. CoPilot sends e-mail (temporary passwords, customer
# portal notifications) with SMTP and optional STARTTLS: a smarthost with
# TLS from the first byte (port 465) is not supported. Without a smarthost
# the e-mail actions of CoPilot are off. Runs before the backend starts.
#

import os
import sys

import agent

# The local Redis replica answers even if the leader node is unreachable
rdb = agent.redis_connect(use_replica=True)
smtp = agent.get_smarthost_settings(rdb)

host = os.environ.get("TRAEFIK_HOST", "localhost")
mail = {}
if smtp.get("enabled") and smtp.get("host"):
    if smtp.get("encrypt_smtp") == "tls":
        print(agent.SD_WARNING + "CoPilot cannot use a smarthost with TLS from the first byte: use STARTTLS", file=sys.stderr)
    mail = {
        "SMTP_HOST": smtp["host"],
        "SMTP_PORT": str(smtp["port"]),
        "SMTP_USE_TLS": "true" if smtp.get("encrypt_smtp") in ("starttls", "tls") else "false",
        "SMTP_FROM": os.environ.get("COPILOT_SMTP_FROM") or smtp.get("username") or f"noreply@{host}",
    }
    if smtp.get("username"):
        mail["SMTP_USERNAME"] = smtp["username"]
        mail["SMTP_PASSWORD"] = smtp.get("password", "")

# Owner only: the file holds the smarthost password. Replace the old file
# only once the new one is complete.
tmp = "smarthost.env.tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    for key, value in mail.items():
        fp.write(f"{key}={value}\n")
os.replace(tmp, "smarthost.env")
